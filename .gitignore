# =========================
# LNMP Template .gitignore
# =========================

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# Environment files
.env
.env.*
!.env.example

# PHP / Composer
vendor/
composer.phar
.phpunit.result.cache

# Node (if frontend assets are added later)
node_modules/
package-lock.json
dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
python/.venv/

# Docker runtime leftovers
*.pid
*.sock

# MariaDB data directory (host-mounted)
mysql/*
!mysql/.gitkeep

# Local cache / temp
tmp/
.cache/
